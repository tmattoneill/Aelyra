# Production deployment target for utils/deploy-prod.sh.
# Copy to .deploy.env and fill in. .deploy.env is gitignored — keep it that way.

REMOTE_USER=ubuntu
REMOTE_HOST=your.server.ip.here
REMOTE_PORT=22
REMOTE_PATH=~/Aelyra

# Command run over ssh to restart the app after a sync.
# e.g. "sudo systemctl restart aelyra" or "cd ~/Aelyra && ./utils/launch-prod.sh"
REMOTE_RESTART_CMD=sudo systemctl restart aelyra
