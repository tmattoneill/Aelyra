# Production deployment target for utils/deploy-prod.sh.
# Copy to .deploy.env and fill in. .deploy.env is gitignored — keep it that way.
#
# Quote every value. This file is sourced, so an unquoted value containing &&
# or spaces would run as a shell command instead of being assigned.

REMOTE_USER="ubuntu"
REMOTE_HOST="your.server.ip.here"
REMOTE_PORT="22"
REMOTE_PATH="~/Aelyra"

# Run over ssh to restart the app after a sync.
# e.g. "sudo systemctl restart aelyra"
REMOTE_RESTART_CMD="sudo systemctl restart aelyra"
